# ============================================
# MAQUINADOS JACO — Variables de entorno
# ============================================
# Copia este archivo como .env.local y llena los valores
# NUNCA subas .env.local al repositorio

# --- CMS / Backend (reutilizadas del proyecto padre) ---

# Contraseña del panel de administración
ADMIN_PASSWORD=

# Secreto para firmar JWT (64 caracteres hex recomendado)
JWT_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=maquinados-jaco-content

# --- Resend (formulario de contacto) ---
# Regístrate en https://resend.com y crea una API key
RESEND_API_KEY=
# A dónde llegan las solicitudes del formulario
CONTACT_TO_EMAIL=contacto@maquinadosjaco.com
# Remitente. Debe ser un dominio verificado en Resend.
# Mientras verificas tu dominio, usa: Maquinados JACO <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Maquinados JACO <onboarding@resend.dev>

# --- URL del sitio (para ISR y meta tags) ---
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# --- Analytics (opcional — el código se activa solo si están presentes) ---
# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
